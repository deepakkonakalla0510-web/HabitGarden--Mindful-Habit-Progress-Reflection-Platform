{
  "name": "habitgarden",
  "version": "1.0.0",
  "description": "Mindful Habit Progress & Reflection Platform",
  "private": true,
  "scripts": {
    "build": "npm --prefix frontend install --include=dev && npm --prefix frontend run build && npm --prefix backend install",
    "start": "node backend/server.js",
    "dev": "npm run start",
    "backend": "cd backend && node server.js",
    "frontend": "cd frontend && npm run dev",
    "test:backend": "cd backend && node test-api.js"
  },
